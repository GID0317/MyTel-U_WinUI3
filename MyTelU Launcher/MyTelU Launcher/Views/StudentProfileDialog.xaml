<ContentDialog
    x:Class="MyTelU_Launcher.Views.StudentProfileDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="KTM Digital" CloseButtonText="Close" DefaultButton="Close">
    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="KtmHeaderBrush" ResourceKey="SystemColorWindowColorBrush"/>
                    <StaticResource x:Key="KtmHeaderTextBrush" ResourceKey="SystemColorWindowTextColorBrush"/>
                    <StaticResource x:Key="KtmBodyBrush" ResourceKey="SystemColorWindowColorBrush"/>
                    <StaticResource x:Key="KtmBodyTextBrush" ResourceKey="SystemColorWindowTextColorBrush"/>
                    <StaticResource x:Key="KtmBadgeBrush" ResourceKey="SystemColorHighlightColorBrush"/>
                    <StaticResource x:Key="KtmBadgeTextBrush" ResourceKey="SystemColorHighlightTextColorBrush"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <x:Double x:Key="ContentDialogMinWidth">448</x:Double>
            <x:Double x:Key="ContentDialogMaxWidth">448</x:Double>
            <SolidColorBrush x:Key="KtmHeaderBrush" Color="White"/>
            <SolidColorBrush x:Key="KtmHeaderTextBrush" Color="#202020"/>
            <SolidColorBrush x:Key="KtmBodyBrush" Color="#C91528"/>
            <SolidColorBrush x:Key="KtmBodyTextBrush" Color="White"/>
            <SolidColorBrush x:Key="KtmBadgeBrush" Color="#154DB8"/>
            <SolidColorBrush x:Key="KtmBadgeTextBrush" Color="White"/>
        </ResourceDictionary>
    </ContentDialog.Resources>
    <StackPanel Spacing="12" MaxWidth="400">
        <Border CornerRadius="{ThemeResource OverlayCornerRadius}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel Padding="24" Spacing="8" Background="{ThemeResource KtmHeaderBrush}">
                    <Image Height="64" MaxWidth="220" Stretch="Uniform" AutomationProperties.Name="Universitas Telkom">
                        <Image.Source>
                            <BitmapImage UriSource="ms-appx:///Assets/Logo_TelkomUniversity.png" DecodePixelWidth="440"/>
                        </Image.Source>
                    </Image>
                    <TextBlock x:Name="FacultyText" Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource KtmHeaderTextBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock x:Name="ProgramText" Foreground="{ThemeResource KtmHeaderTextBrush}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <Grid Padding="20" RowSpacing="20" ColumnSpacing="20" Background="{ThemeResource KtmBodyBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Height="180" CornerRadius="{ThemeResource ControlCornerRadius}"
                            VerticalAlignment="Top" Background="{ThemeResource KtmHeaderBrush}">
                        <Grid>
                            <FontIcon x:Name="PhotoPlaceholder" Glyph="&#xE77B;" FontSize="48"
                                      Foreground="{ThemeResource KtmHeaderTextBrush}"/>
                            <Image x:Name="ProfilePhoto" Stretch="UniformToFill" AutomationProperties.Name="Student photo"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Nama" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource KtmBodyTextBrush}"/>
                            <TextBlock x:Name="NameText" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource KtmBodyTextBrush}"
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Nomor Induk Mahasiswa" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource KtmBodyTextBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="StudentIdText" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource KtmBodyTextBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Kelas" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource KtmBodyTextBrush}"/>
                            <TextBlock x:Name="ClassText" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource KtmBodyTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="CohortPanel" Grid.Row="1" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Angkatan" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource KtmBodyTextBrush}"/>
                        <TextBlock x:Name="CohortText" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource KtmBodyTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel x:Name="StudentTypePanel" Grid.Row="1" Grid.Column="1" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Status" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource KtmBodyTextBrush}"/>
                        <Border Background="{ThemeResource KtmBadgeBrush}" CornerRadius="{ThemeResource ControlCornerRadius}"
                                Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock x:Name="StudentTypeText" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource KtmBadgeTextBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
        <ProgressBar x:Name="LoadingBar" IsIndeterminate="True"/>
        <InfoBar x:Name="StatusBar" IsClosable="False" IsOpen="False"/>
    </StackPanel>
</ContentDialog>
