<Page
    x:Class="MyTelU_Launcher.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:MyTelU_Launcher.Helpers"
    xmlns:controls="using:MyTelU_Launcher.Controls"
    xmlns:behaviors="using:MyTelU_Launcher.Behaviors"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    mc:Ignorable="d"
    Loaded="OnLoaded">

    <Page.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="AccountMenuFlyoutHeaderStyle" TargetType="controls:AccountMenuFlyoutHeader">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:AccountMenuFlyoutHeader">
                        <Grid MinWidth="280" MaxWidth="320" Padding="12,6,14,6" ColumnSpacing="12"
                              AutomationProperties.AccessibilityView="Raw">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PersonPicture Width="36" Height="36" VerticalAlignment="Top"
                                           DisplayName="{TemplateBinding AvatarDisplayName}"
                                           ProfilePicture="{TemplateBinding ProfilePicture}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           Text="{TemplateBinding DisplayName}" TextWrapping="Wrap"/>
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{TemplateBinding Description}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ProgressRing Grid.Column="2" Width="16" Height="16" VerticalAlignment="Center"
                                          IsActive="{TemplateBinding IsBusy}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Overall Page Background -->
        <Grid.Background>
            <SolidColorBrush Color="Transparent"/>
        </Grid.Background>

        <!-- Background Image -->
        <Image Source="{x:Bind ViewModel.BackgroundImage, Mode=OneWay}"
               Grid.RowSpan="2"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Canvas.ZIndex="-1"/>

        <!-- App Title Bar -->
        <TitleBar x:Name="AppTitleBar"
                  Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                  IsBackButtonVisible="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
                  IsBackButtonEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
                  BackRequested="TitleBar_BackRequested"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource>
                    <ImageIconSource.ImageSource>
                        <BitmapImage UriSource="ms-appx:///Assets/Icon_App.png" DecodePixelWidth="64"/>
                    </ImageIconSource.ImageSource>
                </ImageIconSource>
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <Button x:Name="AccountButton" Width="32" Height="32" Padding="0" CornerRadius="16" BorderThickness="0"
                        CenterPoint="16,16,0"
                        PointerEntered="AccountButton_PointerEntered"
                        PointerExited="AccountButton_ResetScale"
                        PointerCanceled="AccountButton_ResetScale"
                        PointerCaptureLost="AccountButton_ResetScale"
                        Style="{StaticResource SubtleButtonStyle}"
                        AutomationProperties.Name="Student profile" ToolTipService.ToolTip="Student profile">
                    <Button.ScaleTransition>
                        <Vector3Transition Duration="0:0:0.08"/>
                    </Button.ScaleTransition>
                    <PersonPicture x:Name="AccountAvatar" Width="32" Height="32"/>
                    <Button.Flyout>
                        <MenuFlyout x:Name="AccountFlyout" Placement="BottomEdgeAlignedRight"
                                Opening="AccountFlyout_Opening" Closed="AccountFlyout_Closed">
                            <controls:AccountMenuFlyoutHeader x:Name="AccountMenuHeader"
                                AutomationProperties.Name="Student account"
                                Style="{StaticResource AccountMenuFlyoutHeaderStyle}"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Name="AccountSignIn" Text="Sign in" Click="AccountSignIn_Click" Visibility="Collapsed">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE748;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="AccountKtm" Text="KTM Digital" Click="AccountKtm_Click">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="ContactInfo"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="AccountSignOut" Text="Sign out" Click="AccountSignOut_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF3B1;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- NavigationView -->
        <NavigationView
            x:Name="NavigationViewControl"
            Grid.Row="1"
            Canvas.ZIndex="0"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}"
            IsSettingsVisible="True"
            ExpandedModeThresholdWidth="1280"
            AlwaysShowHeader="False">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" helpers:NavigationHelper.NavigateTo="MyTelU_Launcher.ViewModels.HomeViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Utilities"/>
                <NavigationViewItem Content="Schedule" x:Name="ScheduleNavItem" helpers:NavigationHelper.NavigateTo="MyTelU_Launcher.ViewModels.ScheduleViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE787;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AttendanceNavItem" Content="Attendance" helpers:NavigationHelper.NavigateTo="MyTelU_Launcher.ViewModels.AttendanceViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEE6F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="GradeNavItem" Content="Grades" helpers:NavigationHelper.NavigateTo="MyTelU_Launcher.ViewModels.GradeViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9F9;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Main Content Area -->
            <Grid Background="Transparent">
                <!-- Content Area Background Image -->
                <Image Source="{x:Bind ViewModel.BackgroundImage, Mode=OneWay}"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Canvas.ZIndex="-1"/>

                <!-- Acrylic layer: shown on non-Home pages to prevent flash on navigation -->
                <Rectangle x:Name="ContentAcrylicLayer"
                           Canvas.ZIndex="0"
                           Fill="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                           Visibility="Collapsed"/>

                <InfoBar
                    x:Name="UpdateAvailableInfoBar"
                    Visibility="{x:Bind ViewModel.IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"
                    Margin="10"
                    IsOpen="True"
                    Severity="Warning"
                    Title="New Update available!"
                    Canvas.ZIndex="2"
                    Message="A new update is available. We recommend updating to the latest version for an enhanced experience and new features.">
                    <InfoBar.ActionButton>
                        <Button Content="Download now" 
                                HorizontalAlignment="Right" 
                                CornerRadius="5"
                                Click="DownloadNowButton_Click"/>
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Main Navigation Frame -->
                <Frame x:Name="NavigationFrame" Background="Transparent">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition/>
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </Grid>

            <NavigationView.HeaderTemplate>
                <DataTemplate>
                    <Grid>
                        <TextBlock Text="{Binding}" Style="{ThemeResource TitleTextBlockStyle}" Foreground="Red"/>
                    </Grid>
                </DataTemplate>
            </NavigationView.HeaderTemplate>

            <i:Interaction.Behaviors>
                <behaviors:NavigationViewHeaderBehavior DefaultHeader="{x:Bind ((ContentControl)ViewModel.Selected).Content, Mode=OneWay}">
                    <behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding}" Style="{ThemeResource TitleTextBlockStyle}" Foreground="Red"/>
                            </Grid>
                        </DataTemplate>
                    </behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                </behaviors:NavigationViewHeaderBehavior>
            </i:Interaction.Behaviors>
        </NavigationView>

        <!-- Overlay Container: Displays on top of all UI when activated -->
        <Grid x:Name="OverlayContainer"
              Grid.RowSpan="2"
              Background="#80000000"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Canvas.ZIndex="10">
            <!-- Inner Frame to host the overlay content (e.g. InAppBrowserPage) -->
            <Frame x:Name="OverlayFrame"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition/>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </Grid>
    </Grid>
</Page>
