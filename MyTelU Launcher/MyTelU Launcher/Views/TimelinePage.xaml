<Page
    x:Class="MyTelU_Launcher.Views.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:MyTelU_Launcher.Behaviors"
    xmlns:helpers="using:MyTelU_Launcher.Helpers"
    xmlns:models="using:MyTelU_Launcher.Models"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Always"
    behaviors:NavigationViewHeaderBehavior.HeaderContext="Timeline"
    Unloaded="Page_Unloaded">
    <behaviors:NavigationViewHeaderBehavior.HeaderTemplate>
        <DataTemplate>
            <Grid ColumnSpacing="16" Margin="0,0,56,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding}" Style="{ThemeResource TitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Click="NewPost_Click" AutomationProperties.Name="New post"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Add"/>
                        <TextBlock Text="New post"/>
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>
    </behaviors:NavigationViewHeaderBehavior.HeaderTemplate>
    <Page.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Page.Resources>

    <Grid Padding="20,8,20,20" MaxWidth="820" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="8">
            <AutoSuggestBox x:Name="TimelineSearch" QueryIcon="Find" PlaceholderText="Search Timeline"
                            QuerySubmitted="Search_QuerySubmitted" AutomationProperties.Name="Search Timeline"/>
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                         AutomationProperties.Name="Loading Timeline"/>
            <InfoBar IsOpen="{x:Bind ViewModel.NeedsLogin, Mode=OneWay}" IsClosable="False"
                     Visibility="{x:Bind ViewModel.NeedsLogin, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                     Title="Sign in to view Timeline" Message="Use your iGracias account to view the Telutizen feed.">
                <InfoBar.ActionButton>
                    <Button Content="Open Schedule" Command="{x:Bind ViewModel.OpenScheduleCommand}"/>
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                     Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                     Title="Couldn't load Timeline" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"/>
            <InfoBar x:Name="ActionStatus" IsOpen="False"
                     Visibility="{Binding IsOpen, ElementName=ActionStatus, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Posts, Mode=OneWay}"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="Timeline_ItemClick" Padding="0"
                  AutomationProperties.Name="Timeline posts">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel CacheLength="1"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:TimelinePost">
                    <Border Padding="12,8,12,10" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="8" Margin="6,4">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <PersonPicture Width="28" Height="28" DisplayName="{x:Bind Author}"
                                                       ProfilePicture="{x:Bind helpers:TimelineAvatar.Create(Photo)}"
                                                       AutomationProperties.AccessibilityView="Raw"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Metadata}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                    <TextBlock helpers:HyperlinkText.Text="{x:Bind Content}" TextWrapping="Wrap" MaxLines="4"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind HasText, Converter={StaticResource BoolToVisibility}}"/>
                                    <Border Padding="6,2" CornerRadius="4" HorizontalAlignment="Left"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{x:Bind IsPinned, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE718;" FontSize="11"
                                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                            <TextBlock Text="Pinned" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                            </StackPanel>
                            <Grid Height="220" Background="{ThemeResource LayerFillColorDefaultBrush}" Margin="6,0"
                                  Visibility="{x:Bind HasImage, Converter={StaticResource BoolToVisibility}}">
                                <ProgressRing IsActive="True" Width="24" Height="24"/>
                                <StackPanel Visibility="Collapsed" Spacing="4" Margin="0,8"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Couldn't load image." TextWrapping="Wrap" TextAlignment="Center"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <Button Click="PostImage_Retry_Click" HorizontalAlignment="Center"
                                            AutomationProperties.Name="Retry loading image"
                                            Style="{StaticResource SubtleButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                            <TextBlock Text="Retry"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <Image Tag="{x:Bind}" Stretch="Uniform" IsHitTestVisible="False"
                                       DataContextChanged="PostImage_DataContextChanged"
                                       Loaded="PostImage_Loaded" Unloaded="PostImage_Unloaded"
                                       AutomationProperties.Name="Post image"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ToggleButton Tag="{x:Bind}" Click="Like_Click" IsChecked="{x:Bind IsLiked, Mode=OneWay}"
                                              AutomationProperties.Name="{x:Bind LikeAction, Mode=OneWay}"
                                              ToolTipService.ToolTip="{x:Bind LikeAction, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8E1;" FontSize="16"/>
                                        <TextBlock Text="{x:Bind LikeLabel, Mode=OneWay}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Button Tag="{x:Bind}" Click="Post_Click" Style="{StaticResource SubtleButtonStyle}"
                                        AutomationProperties.Name="{x:Bind CommentLabel}" ToolTipService.ToolTip="View comments">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8BD;" FontSize="16"/>
                                        <TextBlock Text="{x:Bind CommentLabel, Mode=OneWay}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Tag="{x:Bind}" Click="Share_Click" Style="{StaticResource SubtleButtonStyle}"
                                        AutomationProperties.Name="Share post">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72D;" FontSize="16"/>
                                        <TextBlock Text="Share" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="1" Text="No matching posts on this page." HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>

        <PagerControl x:Name="TimelinePager" Grid.Row="2" DisplayMode="ButtonPanel" HorizontalAlignment="Center"
                      NumberOfPages="{x:Bind ViewModel.TotalPages, Mode=OneWay}"
                      SelectedPageIndex="{x:Bind ViewModel.PagerIndex, Mode=OneWay}"
                      IsEnabled="{x:Bind ViewModel.CanPage, Mode=OneWay}"
                      SelectedIndexChanged="Pager_SelectedIndexChanged" AutomationProperties.Name="Timeline pages"/>
    </Grid>
</Page>
