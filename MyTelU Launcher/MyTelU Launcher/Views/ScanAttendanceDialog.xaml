<ContentDialog
    x:Class="MyTelU_Launcher.Views.ScanAttendanceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:devices="using:Windows.Devices.Enumeration"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="Scan presensi" PrimaryButtonText="Submit attendance" CloseButtonText="Cancel"
    DefaultButton="Close" IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="Submit_Click" Opened="Dialog_Opened" Closing="Dialog_Closing">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">488</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">488</x:Double>
    </ContentDialog.Resources>
    <StackPanel Spacing="16" MaxWidth="440">
        <SelectorBar x:Name="InputModes" SelectionChanged="InputMode_SelectionChanged">
            <SelectorBarItem x:Name="CameraMode" Text="Camera" Icon="Camera"/>
            <SelectorBarItem x:Name="ImageMode" Text="Image" Icon="Pictures"/>
            <SelectorBarItem x:Name="LinkMode" Text="Link" Icon="Link"/>
        </SelectorBar>
        <Grid x:Name="InputPanels">
            <StackPanel x:Name="CameraPanel" Spacing="12">
                <Border Height="220" CornerRadius="{ThemeResource ControlCornerRadius}"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <FontIcon x:Name="CameraPlaceholder" Glyph="&#xE722;" FontSize="40"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Image x:Name="CameraPreview" Stretch="Uniform" AutomationProperties.Name="Camera preview"/>
                    </Grid>
                </Border>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CameraPicker" HorizontalAlignment="Stretch"
                              IsEnabled="False" PlaceholderText="Looking for cameras..." AutomationProperties.Name="Camera">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="devices:DeviceInformation">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="CameraButton" Grid.Column="1" Click="Camera_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon x:Name="CameraActionIcon" Symbol="Camera"/>
                            <TextBlock x:Name="CameraActionText" Text="Start camera"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
            <StackPanel x:Name="ImagePanel" Visibility="Collapsed" Spacing="12" VerticalAlignment="Center">
                <Button x:Name="ImageButton" Click="ChooseImage_Click" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="OpenFile"/>
                        <TextBlock Text="Choose image"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel x:Name="LinkPanel" Visibility="Collapsed" Spacing="12">
                <TextBox x:Name="LinkInput" Header="Attendance link" MaxLength="2048"
                         PlaceholderText="https://mobile.telkomuniversity.ac.id/qrcode/view/..."
                         TextChanged="LinkInput_TextChanged" InputScope="Url"
                         IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                <Button x:Name="ReadLinkButton" Click="ReadLink_Click" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Link"/>
                        <TextBlock Text="Read QR code"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <StackPanel x:Name="ImagePreviewPanel" Visibility="Collapsed" Spacing="8">
            <Border x:Name="ImagePreviewFrame" Visibility="Collapsed" Height="180" Padding="4"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Image x:Name="ImagePreview" Stretch="Uniform" AutomationProperties.Name="Attendance image preview"/>
            </Border>
            <TextBlock x:Name="ImageName" Visibility="Collapsed" TextAlignment="Center" TextWrapping="Wrap"
                       Style="{ThemeResource CaptionTextBlockStyle}"/>
        </StackPanel>
        <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed"
                     AutomationProperties.Name="Reading attendance QR code"/>
        <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False"/>
    </StackPanel>
</ContentDialog>
