<ContentDialog
    x:Class="MyTelU_Launcher.Views.TimelinePostDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MyTelU_Launcher.Models"
    xmlns:helpers="using:MyTelU_Launcher.Helpers"
    Style="{StaticResource DefaultContentDialogStyle}"
    CloseButtonText="Close" DefaultButton="Close" Opened="Dialog_Opened" Closing="Dialog_Closing">
    <ContentDialog.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <x:Double x:Key="ContentDialogMinWidth">480</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
    </ContentDialog.Resources>
    <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="12">
            <TextBlock Text="{x:Bind Post.Timestamp}" Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock helpers:HyperlinkText.Text="{x:Bind Post.Content}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                       SelectionHighlightColor="{ThemeResource TextControlSelectionHighlightColor}"/>
            <ProgressBar x:Name="ImageProgress" Visibility="Collapsed" IsIndeterminate="True"
                         AutomationProperties.Name="Loading attachment"/>
            <Image x:Name="PostImage" Visibility="Collapsed" MaxHeight="280" Stretch="Uniform"
                   DoubleTapped="PostImage_DoubleTapped"
                   ToolTipService.ToolTip="Double-click to open image"
                   AutomationProperties.Name="Post attachment"/>
            <TextBlock x:Name="ImageError" Visibility="Collapsed" Text="Couldn't load the attachment." TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="LikeButton" Click="Like_Click" IsChecked="{x:Bind Post.IsLiked, Mode=OneWay}"
                              AutomationProperties.Name="{x:Bind Post.LikeAction, Mode=OneWay}"
                              ToolTipService.ToolTip="{x:Bind Post.LikeAction, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8E1;" FontSize="16"/>
                        <TextBlock Text="{x:Bind Post.LikeLabel, Mode=OneWay}" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <Button Click="Comments_Click" Style="{StaticResource SubtleButtonStyle}"
                        AutomationProperties.Name="{x:Bind Post.CommentLabel, Mode=OneWay}" ToolTipService.ToolTip="Go to comments">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8BD;" FontSize="16"/>
                        <TextBlock Text="{x:Bind Post.CommentLabel, Mode=OneWay}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <InfoBar x:Name="ActionError" IsOpen="False" Severity="Error"
                     Visibility="{Binding IsOpen, ElementName=ActionError, Converter={StaticResource BoolToVisibility}}"/>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <TextBlock x:Name="CommentsHeading" Text="Comments" Style="{ThemeResource SubtitleTextBlockStyle}"/>
            <StackPanel x:Name="CommentComposer" Spacing="8">
                <Grid>
                    <TextBox x:Name="CommentInput" PlaceholderText="Share your thoughts" AcceptsReturn="True"
                             TextWrapping="Wrap" Height="104" Padding="10,8,10,42"
                             SelectionHighlightColor="{ThemeResource TextControlSelectionHighlightColor}"
                             AutomationProperties.Name="Comment" TextChanged="CommentInput_TextChanged"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,2,2"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock x:Name="CommentCount" Text="0" VerticalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button x:Name="SendCommentButton" Click="SendComment_Click" IsEnabled="False"
                                Width="40" Height="36" Padding="0" Style="{StaticResource SubtleButtonStyle}"
                                AutomationProperties.Name="Post comment" ToolTipService.ToolTip="Post comment">
                            <FontIcon Glyph="&#xE724;" FontSize="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
                <InfoBar x:Name="CommentResult" IsOpen="False" IsClosable="False"/>
            </StackPanel>
            <ProgressBar x:Name="CommentsProgress" IsIndeterminate="True" AutomationProperties.Name="Loading comments"/>
            <TextBlock x:Name="CommentsStatus" Visibility="Collapsed" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <ItemsControl x:Name="CommentItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:TimelineComment">
                        <Grid Margin="0,0,0,12" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <PersonPicture Width="28" Height="28" VerticalAlignment="Top" DisplayName="{x:Bind Author}"
                                           ProfilePicture="{x:Bind helpers:TimelineAvatar.Create(Photo)}"
                                           AutomationProperties.AccessibilityView="Raw"/>
                            <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{x:Bind Author}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Timestamp}" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock helpers:HyperlinkText.Text="{x:Bind Content}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       SelectionHighlightColor="{ThemeResource TextControlSelectionHighlightColor}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
